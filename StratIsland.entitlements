<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime blocks Apple Events unless this is granted; without it the
         Terminal.app click-to-focus path fails silently in a Developer ID build. -->
    <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
